{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/kotlin\" && ./gradlew :core:dependencies --configuration compileClasspath -q >/dev/null 2>&1 || true",
            "shell": "bash",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ]
  }
}
