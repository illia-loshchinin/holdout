<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The devnet RPC endpoint (contracts/android-app.md §1–§2). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rep verification. Frames are analysed in process and discarded: nothing
         is written, nothing is uploaded (FR-022, constitution X).

         RECORD_AUDIO is never declared, here or anywhere (FR-022a). The
         environment check has four visual items and the rep rules are visual
         only; the lost audio anti-spoofing filter is named in the README as a
         known weakness with its real fix beside it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Backup and device transfer are both off: banked reps and a completed day
         waiting for the network live only on this device, and a restore must never
         carry them to another one (FR-024a, ES-3a). On Android 12+ allowBackup
         alone does not stop a device-to-device transfer, so res/xml also excludes
         every domain from <cloud-backup> and <device-transfer>. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Holdout">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Holdout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
