<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ splash: black, with the Holdout mark playing once (1000 ms):
         members drop out, seven survivors turn accent and travel into the H,
         the strokes join it, and it ends on the connected H. The platform
         splash needs no library; below API 31 the plain theme applies. -->
    <style name="Theme.Holdout" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_holdout_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
