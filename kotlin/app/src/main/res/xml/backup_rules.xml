<?xml version="1.0" encoding="utf-8"?><!--
   Nothing in this app is backed up (FR-024a, ES-3a): banked reps, a completed day
   waiting for the network and the cosmetic streak are device-local by design, and
   the chain holds everything that decides money. Used on devices below API 31;
   API 31+ reads data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
