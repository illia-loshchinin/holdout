{
  "$comment": "Golden settlement vectors — PRD §19 V1–V22, revised 2026-10-05 for the 70/30 forfeit split and no carry-over, and 2026-10-09 for the 70/5/5/10/10 re-split. The contract must reproduce these exactly (constitution VII: these exist as failing tests before the logic). Amounts are whole SKR base units.",
  "rules": {
    "fee": "fee = floor(forfeited * 30 / 100), taken at forfeit time",
    "pool": "pool = (forfeited - fee) summed over forfeits",
    "share_per_tier": "share_t = floor(pool * chip_t / total_finisher_stake) — constant time per tier (research R10)",
    "remainder": "remainder = pool - sum over tiers of (finisher_count_t * share_t); sent to the fee destination at settlement (FR-032a)",
    "no_finishers": "developer = floor(pool / 2); operations = pool - developer: the whole pool goes out and nothing carries over (FR-037, H34, H35)",
    "payout": "payout = stake + share_of(stake tier)",
    "forfeit_split": "per forfeited stake s: fee = floor(30% s); boost = floor(5% s); comeback = floor(5% s); developer = floor(10% s); operations = fee - boost - comeback - developer; pool = s - fee (FR-027, H35)",
    "boost": "boost = min(floor(20% of the cohort's own pool), league boost reserve), drawn at finalization before shares (FR-037d)",
    "comeback": "owed = min(floor(10% of the counted forfeited stake), the new stake); refund = floor(entitled * funded / total owed), funded = min(total owed, comeback reserve) (FR-037e)"
  },
