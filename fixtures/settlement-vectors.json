{
  "$comment": "Golden settlement vectors — PRD §19 V1–V22. The contract must reproduce these exactly (constitution VII: these exist as failing tests before the logic). Amounts are whole SKR base units.",
  "rules": {
    "fee": "fee = floor(forfeited * 20 / 100), taken at forfeit time",
    "pool": "pool = (forfeited - fee) summed over forfeits, plus any carry_over_in",
    "share_per_tier": "share_t = floor(pool * chip_t / total_finisher_stake) — constant time per tier (research R10)",
    "remainder": "remainder = pool - sum over tiers of (finisher_count_t * share_t); sent to the fee destination at settlement (FR-032a)",
    "no_finishers": "fee_half = floor(pool / 2); carry_over = pool - fee_half, so the indivisible unit goes to the carry-over (FR-037)",
    "payout": "payout = stake + share_of(stake tier)"
  },
